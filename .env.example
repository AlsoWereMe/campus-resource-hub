# 本地开发（dev）环境变量。使用前复制：cp .env.example .env（make setup 会自动复制）
# 这些口令只用于本机，端口只绑定 127.0.0.1；test / prod 的口令由流水线密钥注入，不写进仓库。

# PostgreSQL：超级用户只用于初始化，各服务使用自己的账号
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev
POSTGRES_DB=campus
POSTGRES_PORT=5432
PLATFORM_DB_PASSWORD=platform-dev
SEAT_DB_PASSWORD=seat-dev
ROOM_DB_PASSWORD=room-dev
REPAIR_DB_PASSWORD=repair-dev

# RabbitMQ（管理界面 http://127.0.0.1:15672）
RABBITMQ_USER=campus
RABBITMQ_PASSWORD=campus-dev
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Redis
REDIS_PORT=6379

# Mailpit：捕获所有外发邮件（界面 http://127.0.0.1:8025）
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
